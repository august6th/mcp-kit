{
    "name": "erp/mcp-kit",
    "description": "ERP MCP gateway shared kit: read-only tool framework, identity, account-level data permission, PII masking.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=7.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "Erp\\McpKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Erp\\McpKit\\McpKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "scripts": {
        "test": "phpunit -c phpunit.xml"
    }
}
